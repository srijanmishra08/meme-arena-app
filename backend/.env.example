# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Postgres connection string. For local dev you can point this at a free
# Supabase/Neon project directly — you don't need Postgres installed locally.
# Example (Supabase): postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres:localtest@localhost:5432/meme_arena
# Set to "false" only if connecting to a local Postgres without SSL.
DATABASE_SSL=false

# Secret Power Automate must send as ?secret=... or x-webhook-secret header
# when calling POST /api/webhook/ms-forms. Make this long and random.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Shared passcode admins/organizers enter to access /organizer dashboard.
ORGANIZER_PASSCODE=change-me-too

# Email notifications (optional — leave blank to disable and rely on the
# admin dashboard + Power Automate's own email/Teams action instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
ORGANIZER_EMAILS=organizer1@company.com,organizer2@company.com
